    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/airport-pickup",
      "regex": "^/airport\\-pickup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/airport\\-pickup(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/booking",
      "regex": "^/booking(?:/)?$",
