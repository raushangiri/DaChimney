1f:T908,{"@context":"https://schema.org","@type":"Product","name":"Da Chimney Boutique Hotel & Restaurant","category":"Hotel","brand":{"@type":"Brand","name":"The DEN by Da Golden Chimney"},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.9,"bestRating":5,"reviewCount":6},"review":[{"@type":"Review","author":{"@type":"Person","name":"Adaeze O."},"reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5},"reviewBody":"The DEN exceeded my expectations completely. Beautiful room, delicious Nigerian and continental breakfast, and a team that never stops smiling. Easily one of the best hotels in Wuse 2, Abuja.","datePublished":"2026-08-14"},{"@type":"Review","author":{"@type":"Person","name":"Ibrahim M."},"reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5},"reviewBody":"We hosted a two-day leadership conference at the Conference Hall. The AV, the lighting and the catering were flawless. Our delegates kept asking where this place was — it's a gem.","datePublished":"2026-07-22"},{"@type":"Review","author":{"@type":"Person","name":"Temitope A."},"reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5},"reviewBody":"Attended a poolside wedding at the Swimming Pool Hall and it was absolutely stunning. The service, the ambience at night, the food — everything was five-star.","datePublished":"2026-06-30"},{"@type":"Review","author":{"@type":"Person","name":"Chiamaka E."},"reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5},"reviewBody":"Reliable WiFi, a proper work desk, and the executive bar after hours. I extended my stay twice. The Executive Deluxe is now my home base in Abuja.","datePublished":"2026-06-08"},{"@type":"Review","author":{"@type":"Person","name":"James B."},"reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5},"reviewBody":"From airport pickup to check-out, everything was smooth. The staff remembered my name and my coffee order. That is the definition of hospitality.","datePublished":"2026-05-19"},{"@type":"Review","author":{"@type":"Person","name":"Ngozi F."},"reviewRating":{"@type":"Rating","ratingValue":5,"bestRating":5},"reviewBody":"The Suite gave our family so much space. The kids loved the pool hall and the restaurant's continental menu. Secure, calm and truly luxurious.","datePublished":"2026-04-27"}]}d:["$","$1","c",{"children":[[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1f"}}]],["$","$L20",null,{}],["$","section",null,{"className":"bg-charcoal-dark py-10","children":["$","div",null,{"className":"lux-container grid grid-cols-2 gap-6 md:grid-cols-4","children":[["$","div","Happy Guests",{"className":"flex flex-col items-center gap-1 text-center","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-heart mb-1 h-6 w-6 text-gold","children":[["$","path","c3ymky",{"d":"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"}],"$undefined"]}],["$","p",null,{"className":"font-display text-2xl font-bold text-cream md:text-3xl","children":"1,200+"}],["$","p",null,{"className":"text-xs uppercase tracking-wide text-cream/60","children":"Happy Guests"}]]}],["$","div","Events Hosted",{"className":"flex flex-col items-center gap-1 text-center","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar-check mb-1 h-6 w-6 text-gold","children":["$L21","$L22","$L23","$L24","$L25","$undefined"]}],"$L26","$L27"]}],"$L28","$L29"]}]}],"$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32"],null,"$L33"]}]
