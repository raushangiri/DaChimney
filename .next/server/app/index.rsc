52:Tea6,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I book a room at The DEN in Abuja?","acceptedAnswer":{"@type":"Answer","text":"You can book directly through our Book Now page, call or WhatsApp us on +234 805 077 9933, or email anita_ansh2002@yahoo.com. Direct bookings give you the best rates and exclusive offers."}},{"@type":"Question","name":"What are the check-in and check-out times?","acceptedAnswer":{"@type":"Answer","text":"Check-in is from 2:00 PM and check-out is by 12:00 PM. Early check-in and late check-out are available on request, subject to availability."}},{"@type":"Question","name":"Do you require a deposit to confirm a booking?","acceptedAnswer":{"@type":"Answer","text":"A deposit or valid card details may be required to confirm high-demand periods and event bookings. Our reservations team will confirm the exact terms when you book."}},{"@type":"Question","name":"Which rooms are available at the hotel?","acceptedAnswer":{"@type":"Answer","text":"We offer the Studio Room (₦50,000 weekday / ₦40,000 weekend), Executive Deluxe (₦80,000 / ₦60,000), Suite (₦150,000 / ₦120,000) and Penthouse (₦150,000 / ₦120,000). All rates include complimentary breakfast."}},{"@type":"Question","name":"Is breakfast included in the room rate?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every room reservation includes a complimentary breakfast served in our restaurant. You can also order from our full menu 24/7 through room service."}},{"@type":"Question","name":"Do the rooms have WiFi and air conditioning?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. All rooms feature free high-speed WiFi, air conditioning, smart TVs, premium bedding, en-suite bathrooms and daily housekeeping."}},{"@type":"Question","name":"Which event venues do you have and what do they cost?","acceptedAnswer":{"@type":"Answer","text":"We have a Meeting Room (up to 50 persons, ₦800,000), a Conference Hall (₦1,000,000) and a Swimming Pool Hall (₦800,000). Contact us for custom packages and weekday corporate rates."}},{"@type":"Question","name":"Can I host a wedding or party at the hotel?","acceptedAnswer":{"@type":"Answer","text":"Yes — the Swimming Pool Hall is perfect for weddings, birthdays and cocktail receptions, while the Conference Hall handles bigger corporate occasions. Our event team handles décor, catering, lighting and sound."}},{"@type":"Question","name":"Do you offer Nigerian and continental dishes?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our restaurant serves authentic Nigerian cuisine alongside a rich continental and international menu, plus a bar with premium wines, spirits and cocktails."}},{"@type":"Question","name":"Can I make a restaurant reservation or private dining booking?","acceptedAnswer":{"@type":"Answer","text":"Certainly. Book a table by phone, WhatsApp, or our Restaurant page. We also arrange private dining experiences for special occasions."}},{"@type":"Question","name":"Do you offer airport pickup?","acceptedAnswer":{"@type":"Answer","text":"Yes. We provide chauffeured airport pickup from Nnamdi Azikiwe International Airport. Share your flight details on our Airport Pickup page and we'll handle the rest."}},{"@type":"Question","name":"Is there secure parking and 24/7 reception?","acceptedAnswer":{"@type":"Answer","text":"Yes. We offer secure on-site parking, a 24/7 reception and round-the-clock room service for your peace of mind."}},{"@type":"Question","name":"Where exactly is the hotel located?","acceptedAnswer":{"@type":"Answer","text":"We are at 20 Agadez Crescent, Wuse 2, Abuja — minutes from Central Business District landmarks, banks, embassies and the best restaurants in Abuja."}}]}31:["$","section",null,{"className":"bg-cream py-16 md:py-24","children":["$","div",null,{"className":"lux-container","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$52"}}]],"$L53"]}]}]
